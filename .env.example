# Secret credentials — never commit the real .env file. Copy to .env and fill in.

# --- Database (per service, each backed by its own DB on the same Postgres instance locally) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- NATS ---
NATS_URL=nats://localhost:4222

# --- Object storage (MinIO) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=doubt-resolver
MINIO_USE_SSL=false

# --- JWT (RS256 key paths) ---
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY=
JWT_ACCESS_TTL=15
JWT_REFRESH_TTL=24

# --- Service-to-service gRPC addresses (used by the gateway) ---
AUTH_ADDR=localhost:50051
USER_ADDR=localhost:50052
QUESTION_ADDR=localhost:50053
MATCHING_ADDR=localhost:50054
SOLUTION_ADDR=localhost:50055
CHAT_ADDR=localhost:50056
NOTIFICATION_ADDR=localhost:50057
KNOWLEDGEBASE_ADDR=localhost:50058
ANALYTICS_ADDR=localhost:50059
ADMIN_ADDR=localhost:50060

# --- GitHub (for the github MCP server) ---
GITHUB_TOKEN=
